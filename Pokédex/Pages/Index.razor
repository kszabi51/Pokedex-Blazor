@page "/"

<PageTitle>Index</PageTitle>

<MudTextField @bind-Value="SearchString"
              Label="Search Pokémon"
              Placeholder="Name or number..."
              Variant="Variant.Outlined"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Clearable="true"
              Immediate="true"
              DebounceInterval="300"
              Class="my-3" />

<MudGrid>
    @if (PokemonList?.results != null)
    {
        var filteredList = string.IsNullOrWhiteSpace(SearchString)
            ? PokemonList.results
            : PokemonList.results.Where(p =>
                (p.RealName?.Contains(SearchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                p.Number.ToString().Contains(SearchString));

        @foreach (var pokemon in filteredList)
        {
            <MudItem @key="pokemon.Number" xs="6" sm="6" md="4" lg="3" xl="2" @onclick="() => PokemonSelected(pokemon.Number)">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h4">@pokemon.Number</MudText>
                            <MudText Typo="Typo.h5">@pokemon.RealName</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <img class="pokemonPicture" src="@pokemon.Picture" height="200" alt="@pokemon.RealName" loading="lazy" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    }
    else if (LoadFailed)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Error">Failed to load Pokémon. Please check your connection and try again later.</MudAlert>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">Loading...</MudAlert>
        </MudItem>
    }
</MudGrid>
